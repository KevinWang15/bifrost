# Copy to .env to override docker-compose.yml's development defaults.
# Configure recipients, SMTP transport and enabled integrations in notifications.json.

# To use a generic webhook, add a webhook entry referencing this variable.
# REPORT_WEBHOOK_URL=https://example.com/cache-report-webhook

# REPORT_GROUP_BY=user_id,virtual_key_id
# REPORT_INTERVAL_SECONDS=86400

# The local stack uses a signed mock Feishu webhook by default.
# For a real group, add a custom bot with signature verification and use:
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
# FEISHU_SIGNING_SECRET=REPLACE_ME
# REPORT_PUBLIC_BASE_URL=https://reports.example.com

# Severity is central and shared by email, Feishu, and JSON webhooks.
# Defaults use 30%/60% miss thresholds; exactly 60% is warning.
# REPORT_WARNING_MISS_PERCENT=30
# REPORT_CRITICAL_MISS_PERCENT=60
# REPORT_MINIMUM_REQUESTS=100

# Compose mounts notifications.json and sets REPORT_NOTIFICATIONS_FILE.
# For authenticated SMTP, reference these names with smtp_username_env and smtp_password_env.
# SMTP_USERNAME=REPLACE_ME
# SMTP_PASSWORD=REPLACE_ME
# REPORT_RETRY_BASE_SECONDS=60
# REPORT_RETRY_MAX_SECONDS=3600
